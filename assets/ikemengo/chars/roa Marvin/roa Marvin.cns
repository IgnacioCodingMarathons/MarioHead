
; Constants and state file.
[Data]
life = 1000
attack = 100
defence = 100
power = 3000
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = S8000
guard.sparkno = S8010
KO.echo = 2
IntPersistIndex = 60
FloatPersistIndex = 40
;---------------------------------------------------------------------------
[Size]
xscale = 2
yscale = 2
ground.back = 15
ground.front = 16
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -90
mid.pos = -5, -60
shadowoffset = 0
draw.offset = 0,0
;---------------------------------------------------------------------------
[Velocity]
walk.fwd  = 2.4
walk.back = -2.2
run.fwd  = 6, 0
run.back = -4.5,-3.8
jump.neu = 0,-8.8
jump.back = -2.55
jump.fwd = 2.5
runjump.back = -2.55,-8.1
runjump.fwd = 4,-8.1
airjump.neu = 0,-8.1
airjump.back = -2.55
airjump.fwd = 2.5
air.gethit.groundrecover = -.15,-3.5
air.gethit.airrecover.mul = .5,.2
air.gethit.airrecover.add = 0,-4.5
air.gethit.airrecover.back = -1
air.gethit.airrecover.fwd = 0
air.gethit.airrecover.up = -2
air.gethit.airrecover.down = 1.5
;---------------------------------------------------------------------------
[Movement]
airjump.num = 1
airjump.height = 35
yaccel = .48
stand.friction = .85
crouch.friction = .82
stand.friction.threshold = 2
crouch.friction.threshold = .05
air.gethit.groundlevel = 25
air.gethit.groundrecover.ground.threshold = -20
air.gethit.groundrecover.groundlevel = 10
air.gethit.airrecover.threshold = -1
air.gethit.airrecover.yaccel = .35
air.gethit.trip.groundlevel = 15
down.bounce.offset = 0, 20
down.bounce.yaccel = .4
down.bounce.groundlevel = 12
down.friction.threshold = .05

;Default language victory quotes **MUGEN 1.0**
;The default language victory quotes must be implemented in English.
[Quotes]
; Up to 100 victory quotes can be specified per language (victory0 - victory99)
victory1 = "Some victory text."

;---------------------------------------------------------------------------
; SUPER JUMP START
[Statedef 60]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

[State 60, Super Jump Sound]
type = PlaySnd
trigger1 = !time
value = S41,0
volumescale = 100

[State 60, 4]
type = VelSet
trigger1 = AnimTime = 0
y = -12

[State 60, Explod]
type = Explod
trigger1 = AnimTime = 0
anim = 8020
ID = 41
pos = 0,13
postype = p1
bindtime = 1
removetime = -2
pausemovetime = 0
scale = 1,1
sprpriority = 5
shadow = 0,0,0
ownpal = 1
removeongethit = 0

[State 60, ChangeState]
type = ChangeState
trigger1 = animtime = 0
value = 61
ctrl = 1
;---------------------------------------------------------------------------
; SUPER JUMP UP
[Statedef 61]
type    = A
physics = A

[State 61, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 61, 4]
type = VelSet
trigger1 = command = "holdfwd"
trigger2 = AILevel
x = 2

[State 61, 4]
type = VelSet
triggerall = !AILevel
trigger1 = command = "holdback"
x = -2

[State 61, Explod]
type = Explod
trigger1 = time%2=0 && time < 25
anim = 8021
ID = 42
pos = 0,-50
postype = p1
random = 60,10
velocity = 0,4
removetime = -2
pausemovetime = 0
scale = 1,1
sprpriority = -1
shadow = 0,0,0
ownpal = 1
removeongethit = 0

[State 61, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 61, 3]
type = ChangeAnim
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 41 && anim <= 43
persistent = 0
value = Anim + 3

;---------------------------------------------------------------------------
; TIME OVER
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, Lose Voice]
type = PlaySnd
trigger1 = !time
value = S170, 0
channel = 0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; WIN RANDOMIZER
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = 181 ; + (random % 2)

;---------------------------------------------------------------------------
; WIN POSE 1
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, Win Voice]
type = PlaySnd
trigger1 = AnimElem = 3
value = S181, 0+Random%2
channel = 0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = time = [0, 200]
flag = roundnotover

;---------------------------------------------------------------------------
; INTRO RANDOMIZER
[Statedef 190]
type = S

[State 190, 1]
type = ChangeState
trigger1 = Time = 0
value = 191 ; + (random % 2)

;---------------------------------------------------------------------------
; INTRO 1
[Statedef 191]
type = S
ctrl = 0
anim = 191
velset = 0,0

[State 191, Intro Voice]
type = PlaySnd
trigger1 = Animelem = 4
value = S57634, 0
channel = 0

[State 0, Explod]
type = Explod
trigger1 = animelem = 4
anim = 57634
pos = 0,0
postype = P1  ;P2, Front, Back, Left, Right


[State 191, 1]
type = ChangeAnim
trigger1 = RoundState = 0
value = 191

[State 191, 2]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

